/* result.wxss - 结果展示 */

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F6FA;
}

.page-container .scrollarea {
  height: auto;
  flex: 1;
}

.page-container .container {
  padding-bottom: 20rpx;
}

.result-page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0 16rpx 0;
  background: none;
  box-shadow: none;
  border-radius: 0;
  margin-bottom: 0;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
}

.result-time {
  font-size: 20rpx;
  color: #999;
}

.result-meta {
  display: flex;
  margin-bottom: 10rpx;
  padding: 16rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.meta-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.meta-value {
  font-size: 24rpx;
  color: #2C3E50;
  flex: 1;
}

.result-content {
  padding: 20rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
  line-height: 1.8;
  font-size: 28rpx;
  color: #2C3E50;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: break-word;
  flex: 1;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #F5F6FA;
  border-top: 1rpx solid #E8ECF1;
  flex-shrink: 0;
  position: sticky;
  bottom: 0;
  z-index: 100;
}

.action-button {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.copy-button {
  background-color: #2196F3;
}

.download-button {
  background-color: #4CAF50;
}

.score-card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.score-header {
  margin-bottom: 20rpx;
}

.score-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
}

.score-content {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.overall-score,
.score-level {
  text-align: center;
}

.score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2196F3;
  display: block;
}

.score-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.level-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #4CAF50;
  display: block;
}

.level-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.score-progress {
  margin-top: 10rpx;
}

.progress-bar {
  width: 100%;
  height: 10rpx;
  background-color: #EEF1F5;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2196F3, #42A5F5);
  border-radius: 5rpx;
  transition: width 0.5s ease;
}
