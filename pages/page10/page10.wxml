<navigation-bar title="行业分析" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="page-content">
      <view class="page-header">
        <text class="page-title">热门行业深度分析</text>
        <text class="page-desc">12个热门行业发展趋势与就业前景</text>
      </view>
      <view class="card-list">
        <view class="c-card {{selectedIndex === index ? 'sel' : ''}}" 
              wx:for="{{list}}" wx:key="title" bindtap="onTap" data-index="{{index}}">
          <view class="c-top">
            <text class="c-num">{{index + 1}}</text>
            <text class="c-cat" style="background:{{item.color}}">{{item.cat}}</text>
          </view>
          <text class="c-title">{{item.title}}</text>
          <text class="c-desc">{{item.desc}}</text>
          <text class="c-arrow">›</text>
        </view>
      </view>
      <view wx:if="{{loading}}" class="gen-bar">
        <text class="gen-text">AI正在生成行业分析...</text>
      </view>
    </view>
  </view>
</scroll-view>
