.page-title{font-size:34rpx;font-weight:700;color:#2C3E50;margin-bottom:8rpx}
.card-list{display:flex;flex-direction:column;gap:14rpx;margin-top:10rpx;padding-bottom:30rpx}
.c-card{background:#FFF;border-radius:14rpx;padding:22rpx 24rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05);position:relative}
.c-card.sel{border:2rpx solid#4CAF50;background:#F1F8E9}
.c-top{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx}
.c-num{width:40rpx;height:40rpx;line-height:40rpx;text-align:center;background:#4CAF50;color:#FFF;font-size:22rpx;font-weight:700;border-radius:50%}
.c-cat{font-size:20rpx;color:#FFF;padding:2rpx 14rpx;border-radius:6rpx}
.c-title{font-size:28rpx;font-weight:700;color:#2C3E50;display:block;margin-bottom:6rpx}
.c-desc{font-size:24rpx;color:#666;line-height:1.5;display:block;padding-right:30rpx}
.c-arrow{position:absolute;right:24rpx;top:50%;transform:translateY(-50%);font-size:32rpx;color:#CCC}
.gen-bar{position:fixed;bottom:0;left:0;right:0;padding:24rpx;background:#4CAF50;text-align:center}
.gen-text{color:#FFF;font-size:26rpx;font-weight:500}
