/* page5.wxss */
.scrollarea {
  height: 100%;
}

.container {
  padding: 20rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.page-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 80%;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.page-description {
  font-size: 28rpx;
  color: #666;
}