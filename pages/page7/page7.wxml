<navigation-bar title="薪资查询" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="page-content">
      <view class="page-header">
        <text class="page-title">岗位薪资查询</text>
        <text class="page-desc">18个热门岗位薪资参考 + AI深度分析</text>
      </view>

      <view class="sal-list">
        <view class="sal-card {{selectedIndex === index ? 'sel' : ''}}"
              wx:for="{{salaryList}}" wx:key="pos"
              bindtap="onSalaryTap" data-index="{{index}}">
          <view class="sal-left">
            <text class="sal-pos">{{item.pos}}</text>
            <text class="sal-ind">{{item.ind}}</text>
            <text class="sal-exp">经验：{{item.exp}}</text>
          </view>
          <view class="sal-right">
            <text class="sal-amount">{{item.sal}}</text>
            <text class="sal-arrow">›</text>
          </view>
        </view>
      </view>

      <view wx:if="{{analyzing}}" class="generating-bar">
        <text class="generating-text">AI正在分析薪资数据...</text>
      </view>
    </view>
  </view>
</scroll-view>
