/* page3.wxss - 个人中心 */

/* ═══════════════════════════════════════════
   未登录空状态
   ═══════════════════════════════════════════ */
.empty-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 60rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.empty-btns {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  max-width: 500rpx;
}

.empty-btns .btn-primary {
  width: 100%;
  height: 80rpx;
  background-color: #2196F3;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.empty-btns .btn-outline {
  width: 100%;
  height: 80rpx;
  background: none;
  color: #2196F3;
  border: 1px solid #2196F3;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ═══════════════════════════════════════════
   头像卡片
   ═══════════════════════════════════════════ */
.avatar-card {
  background-color: #FFFFFF;
  border-radius: 14rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}

.avatar-placeholder {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background-color: #E3F2FD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.avatar-nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 6rpx;
}

.avatar-username {
  font-size: 22rpx;
  color: #999;
}

/* ═══════════════════════════════════════════
   信息卡片
   ═══════════════════════════════════════════ */
.info-card {
  background-color: #FFFFFF;
  border-radius: 14rpx;
  padding: 10rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #2C3E50;
  font-weight: 500;
}

/* ═══════════════════════════════════════════
   统计卡片
   ═══════════════════════════════════════════ */
.stats-card {
  background-color: #FFFFFF;
  border-radius: 14rpx;
  padding: 30rpx 10rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #2196F3;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background-color: #E8ECF1;
}

/* ═══════════════════════════════════════════
   按钮组
   ═══════════════════════════════════════════ */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 30rpx;
}

.btn-item {
  width: 100%;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-item.primary {
  background-color: #2196F3;
  color: #FFFFFF;
}

.btn-item.secondary {
  background-color: #FF9800;
  color: #FFFFFF;
}

.btn-item.danger {
  background-color: #FFFFFF;
  color: #F44336;
  border: 1px solid #F44336;
}

.btn-item.outline {
  background-color: #FFFFFF;
  color: #999;
  border: 1px solid #E0E4E8;
}

/* ═══════════════════════════════════════════
   弹窗
   ═══════════════════════════════════════════ */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

.popup-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 44rpx 36rpx 32rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  box-sizing: border-box;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E50;
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-input {
  width: 100%;
  height: 80rpx;
  border: 1px solid #E0E4E8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #2C3E50;
  background-color: #FAFBFC;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.popup-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.popup-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  text-align: center;
  box-sizing: border-box;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-btn.cancel {
  background: #F5F6FA;
  color: #666;
}

.popup-btn.confirm {
  background: #2196F3;
  color: #FFFFFF;
}
