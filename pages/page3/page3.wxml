<!--page3.wxml-->
<navigation-bar title="个人中心" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="page-content">

      <!-- 未登录状态 -->
      <view class="empty-login" wx:if="{{!isLoggedIn}}">
        <text class="empty-icon">👤</text>
        <text class="empty-title">还未登录</text>
        <text class="empty-desc">登录后可管理个人信息</text>
        <view class="empty-btns">
          <button class="btn-primary" bindtap="login">账号登录</button>
          <button class="btn-outline" bindtap="register">用户注册</button>
        </view>
      </view>

      <!-- 已登录状态 -->
      <block wx:if="{{isLoggedIn}}">
        <!-- 头像区域 -->
        <view class="avatar-card">
        <view class="avatar-placeholder">👤</view>
          <text class="avatar-nickname">{{userInfo.nickname || userInfo.username}}</text>
          <text class="avatar-username">@{{userInfo.username}}</text>
        </view>

        <!-- 信息卡片 -->
        <view class="info-card">
          <view class="info-row">
            <text class="info-label">昵称</text>
            <text class="info-value">{{userInfo.nickname || '未设置'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">邮箱</text>
            <text class="info-value">{{userInfo.email || '未设置'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">手机号</text>
            <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">注册时间</text>
            <text class="info-value">{{userInfo.createdAt || '未知'}}</text>
          </view>
        </view>

        <!-- 数据统计 -->
        <view class="stats-card">
          <view class="stat-item">
            <text class="stat-value">{{stats.paperCount || 0}}</text>
            <text class="stat-label">生成简历</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{stats.evaluateCount || 0}}</text>
            <text class="stat-label">评估简历</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{stats.wordCount || 0}}</text>
            <text class="stat-label">总字数</text>
          </view>
        </view>

        <!-- 功能按钮组 -->
        <view class="btn-group">
          <button class="btn-item primary" bindtap="editProfile">编辑资料</button>
          <button class="btn-item secondary" bindtap="changePassword">修改密码</button>
          <button class="btn-item danger" bindtap="logout">退出登录</button>
          <button class="btn-item outline" bindtap="clearCache">清除缓存</button>
        </view>
      </block>

    </view>
  </view>
</scroll-view>

<!-- 登录弹窗 -->
<view class="popup-mask" wx:if="{{loginPopupVisible}}" bindtap="closeLoginPopup"></view>
<view class="popup-box" wx:if="{{loginPopupVisible}}">
  <view class="popup-title">用户登录</view>
  <input class="popup-input" placeholder="请输入账号" value="{{loginUsername}}" bindinput="onUsernameInput" />
  <input class="popup-input" placeholder="请输入密码" password value="{{loginPassword}}" bindinput="onPasswordInput" />
  <view class="popup-btns">
    <button class="popup-btn cancel" bindtap="closeLoginPopup">取消</button>
    <button class="popup-btn confirm" bindtap="submitLogin">登录</button>
  </view>
</view>

<!-- 注册弹窗 -->
<view class="popup-mask" wx:if="{{registerPopupVisible}}" bindtap="closeRegisterPopup"></view>
<view class="popup-box" wx:if="{{registerPopupVisible}}">
  <view class="popup-title">用户注册</view>
  <input class="popup-input" placeholder="请输入账号" value="{{regUsername}}" bindinput="onRegUsernameInput" />
  <input class="popup-input" placeholder="请输入密码（不少于6位）" password value="{{regPassword}}" bindinput="onRegPasswordInput" />
  <input class="popup-input" placeholder="请输入邮箱" value="{{regEmail}}" bindinput="onRegEmailInput" />
  <view class="popup-btns">
    <button class="popup-btn cancel" bindtap="closeRegisterPopup">取消</button>
    <button class="popup-btn confirm" bindtap="submitRegister">注册</button>
  </view>
</view>

<!-- 编辑资料弹窗 -->
<view class="popup-mask" wx:if="{{editPopupVisible}}" bindtap="closeEditPopup"></view>
<view class="popup-box" wx:if="{{editPopupVisible}}">
  <view class="popup-title">编辑资料</view>
  <input class="popup-input" placeholder="请输入昵称" value="{{editNickname}}" bindinput="onEditNickname" />
  <input class="popup-input" placeholder="请输入手机号" value="{{editPhone}}" bindinput="onEditPhone" />
  <input class="popup-input" placeholder="请输入邮箱" value="{{editEmail}}" bindinput="onEditEmail" />
  <view class="popup-btns">
    <button class="popup-btn cancel" bindtap="closeEditPopup">取消</button>
    <button class="popup-btn confirm" bindtap="submitEdit">{{editSaving ? '保存中...' : '保存'}}</button>
  </view>
</view>

<!-- 修改密码弹窗 -->
<view class="popup-mask" wx:if="{{passwordPopupVisible}}" bindtap="closePasswordPopup"></view>
<view class="popup-box" wx:if="{{passwordPopupVisible}}">
  <view class="popup-title">修改密码</view>
  <input class="popup-input" placeholder="请输入原密码" password value="{{oldPassword}}" bindinput="onOldPasswordInput" />
  <input class="popup-input" placeholder="请输入新密码（不少于6位）" password value="{{newPassword}}" bindinput="onNewPasswordInput" />
  <input class="popup-input" placeholder="请确认新密码" password value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
  <view class="popup-btns">
    <button class="popup-btn cancel" bindtap="closePasswordPopup">取消</button>
    <button class="popup-btn confirm" bindtap="submitPassword">确认修改</button>
  </view>
</view>
