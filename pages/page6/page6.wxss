.page-title { font-size: 34rpx; font-weight: 700; color: #2C3E50; margin-bottom: 8rpx; }
.q-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 10rpx; padding-bottom: 30rpx; }
.q-card {
  background: #FFF; border-radius: 14rpx; padding: 22rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); position: relative;
}
.q-card.sel { border: 2rpx solid #4CAF50; background: #F1F8E9; }
.q-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.q-num {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: #2196F3; color: #FFF; font-size: 22rpx; font-weight: 700; border-radius: 50%;
}
.q-tags-inline { display: flex; gap: 10rpx; }
.q-cat { font-size: 20rpx; color: #666; background: #EEF1F5; padding: 2rpx 12rpx; border-radius: 6rpx; }
.q-diff { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.q-diff.easy { color: #4CAF50; background: #E8F5E9; }
.q-diff.mid { color: #FF9800; background: #FFF3E0; }
.q-diff.hard { color: #F44336; background: #FFEBEE; }
.q-text { font-size: 26rpx; color: #2C3E50; line-height: 1.6; display: block; padding-right: 30rpx; }
.q-arrow { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); font-size: 32rpx; color: #CCC; }
.generating-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx; background: #4CAF50; text-align: center; }
.generating-text { color: #FFF; font-size: 26rpx; font-weight: 500; }
