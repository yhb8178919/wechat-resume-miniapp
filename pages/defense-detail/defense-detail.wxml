<navigation-bar title="面试详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="page-content">
      <view class="detail-card">
        <view class="detail-header">
          <text class="detail-title">{{record.paperTitle || '面试记录'}}</text>
          <text class="detail-time">{{record.date || record.time}}</text>
        </view>

        <view class="score-bar" wx:if="{{record.totalQuestions}}">
          <view class="score-circle">
            <text class="score-num">{{record.correctAnswers}}/{{record.totalQuestions}}</text>
            <text class="score-label">通过率</text>
          </view>
        </view>

        <view class="qa-list" wx:if="{{record.questions}}">
          <view class="qa-item" wx:for="{{record.questions}}" wx:key="index">
            <view class="qa-q">
              <text class="qa-q-label">Q{{index + 1}}</text>
              <text class="qa-q-text">{{item}}</text>
            </view>
            <view class="qa-a" wx:if="{{record.answers[index]}}">
              <text class="qa-a-label">回答</text>
              <text class="qa-a-text">{{record.answers[index] || '未回答'}}</text>
            </view>
            <view class="qa-f" wx:if="{{record.feedbacks[index]}}">
              <text class="qa-f-label">评价</text>
              <text class="qa-f-text">{{record.feedbacks[index]}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
