.detail-card {
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
}

.detail-time {
  font-size: 20rpx;
  color: #999;
}

.score-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.score-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.score-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
}

.qa-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.qa-item {
  background: #FAFBFC;
  border-radius: 10rpx;
  padding: 18rpx;
}

.qa-q {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.qa-q-label {
  font-size: 22rpx;
  color: #FFFFFF;
  background: #2196F3;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 700;
}

.qa-q-text {
  font-size: 26rpx;
  color: #2C3E50;
  font-weight: 600;
  flex: 1;
  line-height: 1.5;
}

.qa-a {
  margin-bottom: 10rpx;
}

.qa-a-label {
  font-size: 20rpx;
  color: #FF9800;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.qa-a-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
}

.qa-f-label {
  font-size: 20rpx;
  color: #4CAF50;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.qa-f-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}
