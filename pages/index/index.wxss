/* index.wxss - 主页面 */

/* ═══════════════════════════════════════════
   顶部横幅
   ═══════════════════════════════════════════ */
.banner {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  padding: 60rpx 0 50rpx;
  text-align: center;
  color: #FFFFFF;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: -30rpx;
  position: relative;
  overflow: hidden;
  width: 100%;
  z-index: 1;
}

.banner::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.12) 0%, transparent 50%);
  pointer-events: none;
}

.banner-content {
  padding: 0 40rpx;
  box-sizing: border-box;
}

.banner-title {
  font-size: 48rpx;
  font-weight: 800;
  text-shadow: 0 3rpx 6rpx rgba(0,0,0,0.15);
  line-height: 64rpx;
  letter-spacing: 2rpx;
  display: block;
}

.banner-subtitle {
  font-size: 26rpx;
  opacity: 0.92;
  line-height: 36rpx;
  display: block;
  margin-top: 12rpx;
}

.banner-desc {
  font-size: 20rpx;
  opacity: 0.78;
  line-height: 30rpx;
  display: block;
  margin-top: 6rpx;
}

/* ═══════════════════════════════════════════
   通用分区
   ═══════════════════════════════════════════ */
.section {
  padding: 30rpx 0 0 0;
  position: relative;
  z-index: 2;
}

.section-header {
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2C3E50;
  line-height: 44rpx;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999;
  line-height: 30rpx;
  margin-top: 2rpx;
}

/* ═══════════════════════════════════════════
   一、核心功能 - 2x3 网格卡片
   ═══════════════════════════════════════════ */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}

.feature-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  min-height: 200rpx;
  position: relative;
  overflow: hidden;
}

.feature-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, #2196F3, #42A5F5);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}

.feature-card:active {
  transform: translateY(-3rpx);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
}

.feature-card:active::before {
  transform: scaleX(1);
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 14rpx;
}

.feature-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 6rpx;
  text-align: center;
  line-height: 1.2;
}

.feature-card-desc {
  font-size: 20rpx;
  color: #999;
  text-align: center;
  line-height: 28rpx;
}

/* ═══════════════════════════════════════════
   二、实用工具 - 列表式卡片
   ═══════════════════════════════════════════ */
.tool-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 24rpx;
}

.tool-card {
  background-color: #FFFFFF;
  border-radius: 14rpx;
  padding: 20rpx 20rpx 20rpx 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
  transition: all 0.2s ease;
}

.tool-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.tool-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-blue  { background-color: #E3F2FD; }
.icon-green { background-color: #E8F5E9; }
.icon-orange { background-color: #FFF3E0; }
.icon-purple { background-color: #F3E5F5; }

.tool-icon {
  font-size: 36rpx;
}

.tool-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.tool-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2C3E50;
  line-height: 1.3;
}

.tool-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
  line-height: 1.4;
}

.tool-arrow {
  font-size: 28rpx;
  color: #CCC;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* ═══════════════════════════════════════════
   三、求职资讯 - 横向滚动卡片
   ═══════════════════════════════════════════ */
.news-scroll {
  width: 100%;
  height: 260rpx;
  flex-shrink: 0;
}

.news-list {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 0 24rpx;
  height: 100%;
  align-items: stretch;
}

.news-card {
  width: 260rpx;
  min-width: 260rpx;
  max-width: 260rpx;
  background-color: #FFFFFF;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.news-card:active {
  transform: translateY(-3rpx);
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.08);
}

.news-cover {
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cover-blue   { background: linear-gradient(135deg, #42A5F5, #1E88E5); }
.cover-green  { background: linear-gradient(135deg, #66BB6A, #43A047); }
.cover-orange { background: linear-gradient(135deg, #FFA726, #FB8C00); }
.cover-purple { background: linear-gradient(135deg, #AB47BC, #8E24AA); }

.news-icon {
  font-size: 48rpx;
}

.news-card-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2C3E50;
  padding: 12rpx 14rpx 0 14rpx;
  line-height: 1.3;
  flex-shrink: 0;
}

.news-card-desc {
  font-size: 19rpx;
  color: #999;
  padding: 6rpx 14rpx 14rpx 14rpx;
  line-height: 26rpx;
  flex: 1;
}

/* ═══════════════════════════════════════════
   底部
   ═══════════════════════════════════════════ */
.bottom-space {
  height: 40rpx;
}

/* ═══════════════════════════════════════════
   响应式
   ═══════════════════════════════════════════ */
@media (max-width: 375px) {
  .feature-grid {
    grid-template-columns: 1fr 1fr;
    gap: 12rpx;
  }
  .feature-card {
    min-height: 180rpx;
    padding: 24rpx 12rpx;
  }
  .feature-icon {
    font-size: 44rpx;
  }
  .banner-title {
    font-size: 40rpx;
  }
  .banner-subtitle {
    font-size: 22rpx;
  }
}
