<navigation-bar title="职场百科" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="page-content">
      <view class="page-header">
        <text class="page-title">职场百科全知道</text>
        <text class="page-desc">15个职场必备知识点，AI为你解答</text>
      </view>
      <view class="card-list">
        <view class="c-card {{selectedIndex === index ? 'sel' : ''}}" 
              wx:for="{{list}}" wx:key="title" bindtap="onTap" data-index="{{index}}">
          <view class="c-top">
            <text class="c-num">{{index + 1}}</text>
            <text class="c-cat" style="background:{{item.color}}">{{item.cat}}</text>
          </view>
          <text class="c-title">{{item.title}}</text>
          <text class="c-desc">{{item.desc}}</text>
          <text class="c-arrow">›</text>
        </view>
      </view>
      <view wx:if="{{loading}}" class="gen-bar">
        <text class="gen-text">AI正在生成百科解答...</text>
      </view>
    </view>
  </view>
</scroll-view>
