/* career.wxss - 职业推荐 */

.content-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex: 1;
}

.import-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3E50;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2C3E50;
  box-sizing: border-box;
  background-color: #FFFFFF;
}

.textarea {
  width: 100%;
  height: 180rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2C3E50;
  box-sizing: border-box;
  background-color: #FFFFFF;
}

.recommend-button {
  width: 100%;
  height: 88rpx;
  background-color: #2196F3;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 10rpx;
}

.recommend-button[disabled] {
  background-color: #CCC;
  opacity: 0.55;
}

.result-area {
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-top: 20rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: nowrap;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
  flex-shrink: 0;
}

.result-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  font-size: 22rpx;
  color: #2196F3;
  padding: 6rpx 16rpx;
  border: 1rpx solid #2196F3;
  border-radius: 8rpx;
  white-space: nowrap;
}

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommendation-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #F8FBFF;
  border-radius: 10rpx;
  border: 1rpx solid #E8ECF1;
}

.recommendation-rank {
  width: 44rpx;
  height: 44rpx;
  background-color: #2196F3;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.recommendation-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommendation-job {
  font-size: 26rpx;
  font-weight: 700;
  color: #2C3E50;
}

.recommendation-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 32rpx;
}

.recommendation-reason {
  font-size: 22rpx;
  color: #999;
  line-height: 28rpx;
}

.result-area.empty {
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-result-text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}