/* page1.wxss - AI生成简历 */

.content-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3E50;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2C3E50;
  box-sizing: border-box;
  background-color: #FFFFFF;
}

.picker {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
}

.picker-text {
  color: #666;
}

.textarea {
  width: 100%;
  height: 180rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2C3E50;
  box-sizing: border-box;
  background-color: #FFFFFF;
}

.generate-button {
  width: 100%;
  height: 88rpx;
  background-color: #2196F3;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 10rpx;
}

.generate-button[disabled] {
  background-color: #CCC;
  opacity: 0.55;
}

.result-area {
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
}

.copy-button {
  font-size: 24rpx;
  color: #2196F3;
  padding: 8rpx 20rpx;
  border: 1rpx solid #2196F3;
  border-radius: 8rpx;
}

.result-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  white-space: pre-wrap;
}
