/* ═══════════════════════════════════════════
   AI简历助手 - 全局设计系统
   ═══════════════════════════════════════════ */

/* 颜色变量（通过类名体系实现） */
/* 主色 #2196F3  辅色 #4CAF50  警告 #FF9800  危险 #F44336 */
/* 背景 #F5F6FA  卡片 #FFFFFF  文字主 #2C3E50  文字次 #666  文字弱 #999 */
/* 边框 #E8ECF1  阴影 rgba(0,0,0,0.06) */

/* ── 基础重置 ── */
page {
  background-color: #F5F6FA;
  margin: 0;
  padding: 0;
  width: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  box-sizing: border-box;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

/* ── 通用滚动区 ── */
.scrollarea {
  height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* ── 通用容器 ── */
.container {
  padding: 12rpx 20rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background-color: #F5F6FA;
  width: 100%;
}

/* ── 页面内容块 ── */
.page-content {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.page-header {
  padding: 4rpx 0 12rpx 0;
  text-align: center;
}

.page-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

/* 保留旧类名兼容 */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
  text-align: center;
  margin-bottom: 10rpx;
  line-height: 1.3;
}

.page-description {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* ── 节标题（左侧蓝色竖线风格） ── */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 14rpx;
  padding-left: 14rpx;
  border-left: 5rpx solid #2196F3;
  line-height: 1.2;
}

/* ── 白色卡片 ── */
.card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* ── 文件上传区域 ── */
.upload-box {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #2196F3;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #F8FBFF;
  transition: all 0.2s ease;
}

.upload-box:active {
  background-color: #EDF4FF;
  border-color: #1976D2;
}

.upload-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #2C3E50;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #999;
}

.uploaded-file {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #E8F5E9;
  border-radius: 10rpx;
  border: 1rpx solid #4CAF50;
}

.file-icon {
  font-size: 30rpx;
  color: #4CAF50;
  margin-right: 12rpx;
  font-weight: bold;
}

.file-name {
  font-size: 26rpx;
  color: #2C3E50;
  flex: 1;
}

.file-size {
  font-size: 22rpx;
  color: #999;
}

/* ── 表单通用 ── */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 100%;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3E50;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2C3E50;
  background-color: #FFFFFF;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  border: 1rpx solid #E8ECF1;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2C3E50;
  background-color: #FFFFFF;
  box-sizing: border-box;
}

/* ── 按钮体系 ── */
.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary {
  background-color: #2196F3;
  color: #FFFFFF;
}

.btn-primary:active {
  background-color: #1976D2;
}

.btn-success {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.btn-success:active {
  background-color: #388E3C;
}

.btn-danger {
  background-color: #F44336;
  color: #FFFFFF;
}

.btn-danger:active {
  background-color: #D32F2F;
}

.btn-warning {
  background-color: #FF9800;
  color: #FFFFFF;
}

.btn-warning:active {
  background-color: #F57C00;
}

.btn-outline {
  background-color: transparent;
  color: #2196F3;
  border: 1rpx solid #2196F3;
  height: auto;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.btn-outline-danger {
  background-color: transparent;
  color: #F44336;
  border: 1rpx solid #F44336;
  height: auto;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.btn-disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

/* ── 标签页 ── */
.tabs {
  display: flex;
  width: 100%;
  background-color: #EEF1F5;
  border-radius: 12rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border-radius: 10rpx;
  transition: all 0.25s ease;
}

.tab-item.active {
  background-color: #2196F3;
}

.tab-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #FFFFFF;
  font-weight: 600;
}

/* ── 评分展示 ── */
.score-card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2196F3;
  display: block;
  text-align: center;
}

.score-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  text-align: center;
  margin-top: 6rpx;
}

.level-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #4CAF50;
  display: block;
  text-align: center;
}

.progress-bar {
  width: 100%;
  height: 10rpx;
  background-color: #EEF1F5;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2196F3, #42A5F5);
  border-radius: 5rpx;
  transition: width 0.6s ease;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

/* ── 禁用状态 ── */
button[disabled] {
  opacity: 0.55;
}
